# ---------------------------------------------------------------------------
# Humanize — environment variables
# Copy to .env.local for development. In production, set these in:
# Vercel -> Project -> Settings -> Environment Variables
# Never commit real values. Names only below.
# ---------------------------------------------------------------------------

# --- Database (Postgres — e.g. Vercel Postgres, Neon, Supabase) ---
DATABASE_URL=

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI providers (server-side only — never prefix with NEXT_PUBLIC_) ---
# At least one is required. OPENROUTER_API_KEY is the primary provider
# wired up in this build; the others are implemented behind the same
# interface and activate automatically once a key is present.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- AI provider order (comma separated, first = primary) ---
AI_PROVIDER_ORDER=openrouter,anthropic,gemini,groq,deepseek

# --- Search / research providers (optional — citation assistant) ---
TAVILY_API_KEY=
SERPER_API_KEY=
YOU_API_KEY=

# --- Admin ---
# Comma-separated list of user emails allowed into /admin.
ADMIN_EMAILS=
